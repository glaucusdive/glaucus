LLM_PROVIDER=openai

# OpenAI provider
OPENAI_API_KEY=sk-...
# Optional single-model override used for any provider
# LLM_CHAT_MODEL=gpt-5.5
OPENAI_CHAT_MODEL=gpt-5.5

# Gemini provider (Google AI Studio, OpenAI-compatible endpoint)
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=AIza...
# GEMINI_CHAT_MODEL=gemini-2.0-flash

# Optional: route calls through LangChain to emit LangSmith traces
USE_LANGCHAIN=false

# Supabase (used by orchestrator read-only DB probe/search helpers)
SUPABASE_URL=https://your-project.supabase.co
# Prefer the service role key for server-side reads
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Optional fallback if you are testing locally without a service role key
# SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Demo / test user (created manually in Supabase Dashboard → Auth → Users) ──
# These are only used by supabase_user_demo.py to sign in as a real user
# and query tables with a user-scoped JWT (subject to RLS).
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=YourPassword123!

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<key>
LANGSMITH_PROJECT="deepdive"
# Port for the FastAPI dev server
PORT=8001

