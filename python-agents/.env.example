LLM_PROVIDER=openai

# OpenAI provider
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-5.5

# Gemini provider (Google AI Studio, OpenAI-compatible endpoint)
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=AIza...
# GEMINI_CHAT_MODEL=gemini-2.0-flash

# Optional: route calls through LangChain to emit LangSmith traces
USE_LANGCHAIN=false

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<key>
LANGSMITH_PROJECT="deepdive"
# Port for the FastAPI dev server
PORT=8001

