# Copy this file to .env and set only the values needed for local development.
# Never commit .env or put real credentials in this template.

NUXT_SITE_URL=http://localhost:3000

# Supabase: use `supabase start` output or a development project.
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# AI: disabled locally by default. Set false and provide a key to test model calls.
NUXT_PUBLIC_DISABLE_CHAT_AI=true
NUXT_OPENAI_API_KEY=
NUXT_PUBLIC_AI_SEARCH_FIRST=false
NUXT_PUBLIC_USE_GUIDED_SEARCH=true
NUXT_PUBLIC_BOOKING_SIGNUP_TIMING=off
NUXT_PUBLIC_TEST_MODE=true

# Email: blank values disable optional notifications; configure test recipients only.
RESEND_API_KEY=
BOOKING_FROM_EMAIL=
BOOKING_BCC_EMAILS=
BOOKING_FALLBACK_EMAILS_LIST=
PROFILE_UPDATE_NOTIFY_EMAILS=
SHOP_SUBMISSION_NOTIFY_EMAILS=
NUXT_SHOP_INQUIRY_NOTIFY_EMAIL=

# Linear feedback integration (optional).
NUXT_LINEAR_API_KEY=
NUXT_LINEAR_TEAM_ID=
NUXT_LINEAR_FEEDBACK_STATE_ID=

# PostHog analytics (optional, disabled by default).
NUXT_PUBLIC_POSTHOG_ENABLED=false
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=
NUXT_PUBLIC_POSTHOG_MARK_TEST_TRAFFIC=false
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com

# Google Analytics 4 (optional, disabled by default).
NUXT_PUBLIC_GA4_ENABLED=false
NUXT_PUBLIC_GA4_ID=
